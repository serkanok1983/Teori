== kb-ea-4-7 süreç madenciliği (sqlite)
select varyant, count(*) vaka_sayisi from (
  select vaka, group_concat(aktivite,' > ') varyant from (select * from olay order by vaka, zaman) group by vaka)
group by varyant order by vaka_sayisi desc;
('Sipariş > Onay > Sevk > Fatura', 3)
('Sipariş > Sevk > Fatura > Fatura', 1)
('Sipariş > Sevk > Fatura', 1)
select vaka, round((julianday(max(zaman))-julianday(min(zaman)))*24,1) saat from olay group by vaka order by saat desc;
('S5', 70.5)
('S3', 46.3)
('S1', 23.2)
('S4', 22.1)
('S2', 6.1)
