== kb-ea-6-4 görevler ayrılığı çakışması (SQLite)
select a.kullanici from yetki a join yetki b on a.kullanici=b.kullanici
where a.islem='cari_kart_ac' and b.islem='odeme_onayla' order by 1;
[('ali',), ('ayse',)]
