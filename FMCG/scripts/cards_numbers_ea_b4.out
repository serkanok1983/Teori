== kb-ea-18-6 açılış bakiyesi mutabakatı (sqlite)
SQL: select coalesce(e.cari,y.cari) cari, e.bakiye_kurus eski, y.bakiye_kurus yeni,  coalesce(y.bakiye_kurus,0)-coalesce(e.bakiye_kurus,0) fark  from eski e left join yeni y on e.cari=y.cari  union all select y.cari,null,y.bakiye_kurus,y.bakiye_kurus from yeni y where y.cari not in (select cari from eski)
